# Large / temporary run artifacts (keep directory placeholders via .gitkeep)
outputs/**/*.jsonl
outputs/**/*.json
!outputs/**/.gitkeep

# Formal baseline Test artifacts (explicitly tracked)
!outputs/qwen_only/predictions.jsonl
!outputs/qwen_only/metrics.json
!outputs/qwen_only/run_config.json
!outputs/rag_matched_test_context_fallback/predictions.jsonl
!outputs/rag_matched_test_context_fallback/metrics.json
!outputs/rag_matched_test_context_fallback/run_config.json

# Product evaluation dirs (smoke always local; formal artifacts tracked when present)
!outputs/adaptive_product_test/
!outputs/adaptive_product_test/.gitkeep
!outputs/adaptive_product_smoke/
!outputs/adaptive_product_smoke/.gitkeep
!outputs/adaptive_product_test/predictions.jsonl
!outputs/adaptive_product_test/metrics.json
!outputs/adaptive_product_test/run_config.json
outputs/adaptive_product_smoke/**
!outputs/adaptive_product_smoke/.gitkeep

__pycache__/
*.py[cod]

# Local reevaluate safety copies (not formal artifacts)
outputs/**/_backup/
outputs/**/*.bak
outputs/**/*.tmp

# Secrets / local env (never commit)
.env
.env.*
*.pem
*secret*
*credentials*

# LLM Judge: ignore temps by default; allow formal full-run artifacts only
outputs/judge/**
!outputs/judge/.gitkeep
!outputs/judge/qwen_only_full/
!outputs/judge/qwen_only_full/judge_results.jsonl
!outputs/judge/qwen_only_full/judge_summary.json
!outputs/judge/qwen_only_full/run_config.json
!outputs/judge/rag_matched_full/
!outputs/judge/rag_matched_full/judge_results.jsonl
!outputs/judge/rag_matched_full/judge_summary.json
!outputs/judge/rag_matched_full/run_config.json
!outputs/judge/adaptive_product_full/
!outputs/judge/adaptive_product_full/judge_results.jsonl
!outputs/judge/adaptive_product_full/judge_summary.json
!outputs/judge/adaptive_product_full/run_config.json

judge/**/tmp/
judge/**/*.request.json
judge/**/*.response.json

# Ignore temporary split copies
splits/*.tmp
splits/*_copy.json
