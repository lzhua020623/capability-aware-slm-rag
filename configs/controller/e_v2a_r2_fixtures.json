  "label_definitions": {
    "scope": "Judge the ENTERING ANSWER (NQ short answer, FEVER label) against the supplied evidence only; never world knowledge.",
    "supported": "The evidence establishes that the entering answer is correct. NQ: a passage states the requested fact and it matches the entering answer. FEVER: the evidence establishes the claim when the entering label is SUPPORTS, or explicitly contradicts the claim when the entering label is REFUTES.",
    "contradicted": "The evidence explicitly establishes that the entering answer is wrong. NQ: the evidence gives a different value for the exact requested fact, or explicitly rules out the entering answer. FEVER: the evidence establishes the opposite label. Internal name: unsupported.",
    "insufficient": "The evidence neither establishes nor rules out the entering answer: the requested fact is absent (only related facts are present), or relevant passages give conflicting values and the evidence itself does not resolve which is right. Absence of support is never contradiction. If passages give incompatible answers and the evidence does not state which is correct, the verdict is insufficient even when one passage matches the entering answer; source names, authority, recency or rank do not resolve a conflict, and unstated events (a recasting, a re-founding, a second attempt) must not be invented to reconcile it.",
    "replacement": "Only after contradicted. NQ: the shortest continuous evidence span (at most 20 words) that answers the requested fact, otherwise empty. FEVER: the opposite legal label.",
    "final_action": "replace only when contradicted and a valid replacement exists; otherwise keep the entering answer. The system never abstains: a contradicted answer without a replacement is kept as the final answer and flagged unresolved.",
    "unresolved": "false only for supported, or contradicted with a replacement"
  },
  "pass_fields": [
    "original_verification",
    "final_action",
    "unresolved",
    "final_answer"
  ],
  "final_answer_rule": "normalized final answer equals one of expected.acceptable_final_answers (registered before any r2 run)",
  "diagnostic_only": {
    "key_evidence_ids": "whether the selected verdict/replacement IDs include a registered key sentence; recorded, never a pass condition"
