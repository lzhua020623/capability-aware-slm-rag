{
  "version": "p60_online_adapter_v1",
  "source": "EXP-P60",
  "policy": "C_two_lane_balanced",
  "probe_enabled": false,
  "coverage_target": 0.35,
  "lane1_frac": 0.25,
  "d_combo": {
    "formula": "alpha * z(p_fail) + (1-alpha) * z(rec) - lam * z(p_corr_3c)",
    "alpha": 0.4,
    "lam": 0.5
  },
  "thresholds": {
    "t_insuff": 0.5349365680553068,
    "t_combo": 0.49535149245589105
  },
  "z_stats": {
    "p_fail": {"mean": 0.7839028583268338, "std": 0.09133948326095279},
    "rec": {"mean": 0.1545369827752141, "std": 0.17590100016725163},
    "p_corr": {"mean": 0.3103788626352992, "std": 0.27597145951696583}
  },
  "target3_labels": [
    "recoverable_failure",
    "unrecoverable_failure",
    "true_correct_exposure"
  ],
  "p_corr_class_index": 2,
  "models": {
    "hgb_fail_gate": "models/controller/p60_online_adapter/hgb_fail_gate.joblib",
    "hgb_rec_given_fail": "models/controller/p60_online_adapter/hgb_rec_given_fail.joblib",
    "hgb_3c": "models/controller/p60_online_adapter/hgb_3c.joblib"
  },
  "feature_names": [
    "top1_score",
    "top2_score",
    "score_gap_1_2",
    "score_mean_top5",
    "score_std_top5",
    "score_range_top5",
    "query_coverage_top1",
    "query_coverage_max5",
    "query_coverage_mean5",
    "answer_in_top1",
    "answer_in_any",
    "answer_first_rank",
    "answer_passage_count",
    "answer_token_coverage_max",
    "answer_length_tokens",
    "answer_is_abstention",
    "is_refutes_prediction",
    "query_length_tokens",
    "evidence_total_tokens",
    "evidence_mean_tokens",
    "evidence_max_tokens",
    "is_fever",
    "is_when",
    "is_who",
    "is_where",
    "is_what",
    "is_how_many",
    "p26_qa_support_max",
    "p26_qa_support_mean_top3",
    "p26_qa_support_first_rank",
    "p26_qa_support_margin",
    "p26_qa_support_concentration",
    "p26_support_peak_dispersion",
    "p26_top_support_margin",
    "p26_evidence_agreement_mean",
    "p26_evidence_agreement_min",
    "p26_answer_evidence_max_similarity",
    "p26_answer_evidence_top1_similarity",
    "p26_answer_evidence_mean_topk",
    "p26_qa_type_match",
    "p26_s5_rerank_best_chunk",
    "p26_s5_rerank_top1_passage",
    "p26_chunk_max",
    "p26_chunk_mean",
    "p26_chunk_std",
    "p26_pass_max",
    "p26_pass_mean",
    "p26_pass_std",
    "p26_qtype_0",
    "p26_qtype_1",
    "p26_qtype_2",
    "p26_qtype_3",
    "p26_qtype_4",
    "p26_qtype_5",
    "p26_qtype_6",
    "p26_qtype_7",
    "p26_atype_0",
    "p26_atype_1",
    "p26_atype_2",
    "p26_atype_3",
