  "required_runtime_fields": [
    "HierarchicalDiagnosis.stage1_failure_probability",
    "HierarchicalDiagnosis.class_scores or stage2_class_scores for p_insuff",
    "adapter_features aligned to feature_names"
  ],
  "online_logic": [
    "if Diagnosis final_label is correct -> no_action",
    "if p_insuff >= t_insuff -> selected / insuff_preserve",
    "elif D_combo_frozen_z >= t_combo -> selected / residual_combo",
    "else -> no_action",
    "if selected: failure_type = Diagnosis.final_label (never overridden)"
  ]
}
