 ],
 "online_logic": [
  "if Diagnosis final_label is correct -> no_action",
  "if p_insuff >= t_insuff -> selected / insuff_preserve",
  "elif D_combo_frozen_z >= t_combo -> selected / residual_combo",
  "else -> no_action",
  "if selected: failure_type = Diagnosis.final_label (never overridden)"
 ],
