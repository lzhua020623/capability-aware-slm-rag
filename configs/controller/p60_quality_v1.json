{
 "version": "p60_quality_v1",
 "source": "EXP-P60 models; thresholds and z-stats recalibrated on the quality sweep failure pool (configs/controller/quality_sweep_v1.json)",
 "policy": "C_two_lane_balanced",
 "probe_enabled": false,
 "coverage_target": 1.0,
 "lane1_frac": 0.25,
 "d_combo": {
  "formula": "alpha * z(p_fail) + (1-alpha) * z(rec) - lam * z(p_corr_3c)",
  "alpha": 0.4,
  "lam": 0.5
 },
 "thresholds": {
  "t_insuff": 0.2835542752643663,
  "t_combo": -2.052323613879965
 },
 "z_stats": {
  "p_fail": {
   "mean": 0.6841148146663475,
   "std": 0.12744149762646886
  },
  "rec": {
   "mean": 0.12902077522079008,
   "std": 0.1304293892703225
  },
  "p_corr": {
   "mean": 0.39639503408197335,
   "std": 0.25810222344125683
  }
 },
 "target3_labels": [
  "recoverable_failure",
  "unrecoverable_failure",
  "true_correct_exposure"
 ],
 "p_corr_class_index": 2,
 "models": {
  "hgb_fail_gate": "models/controller/p60_online_adapter/hgb_fail_gate.joblib",
  "hgb_rec_given_fail": "models/controller/p60_online_adapter/hgb_rec_given_fail.joblib",
  "hgb_3c": "models/controller/p60_online_adapter/hgb_3c.joblib"
 },
