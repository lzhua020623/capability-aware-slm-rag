    "expected_ntotal": 1224119
  },
  "rag_prompt": {
    "default_style": "context_fallback",
    "frozen_verdict": "FREEZE_CONTEXT_FALLBACK"
  },
  "resources_registry": "configs/controller/nq_train_resources_v1.json"
